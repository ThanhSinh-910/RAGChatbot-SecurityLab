# ============================================================
# FILE CẤU HÌNH MÔI TRƯỜNG - RAG Security Lab (Nhóm A10 VKU)
# ============================================================
# HƯỚNG DẪN:
#   1. Sao chép file này thành file tên ".env" (xóa phần ".example")
#   2. Thay "your_google_api_key_here" bằng API key thật của bạn
#   3. Lấy API key miễn phí tại: https://aistudio.google.com/api-keys
#   4. File .env sẽ KHÔNG được commit lên git (đã có trong .gitignore)
#
# QUAN TRỌNG: Không chia sẻ file .env hoặc API key của bạn với bất kỳ ai!
# ============================================================

# Google Gemini API Key (BẮT BUỘC để dùng Chatbot LLM)
GOOGLE_API_KEY=your_google_api_key_here

# Model Gemini sử dụng (Tùy chọn — mặc định: gemini-2.0-flash-lite)
# Các lựa chọn khác: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
RAG_EXPERIMENT_MODEL=gemini-2.0-flash-lite
